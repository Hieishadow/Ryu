<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ryujinx" value="https://git.ryujinx.app/api/packages/Ryujinx/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ryujinx">
      <package pattern="Ryujinx.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
