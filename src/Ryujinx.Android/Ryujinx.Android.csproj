<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.ryubing.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0-MASTER-REAL</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>

    <!-- Compatibilidade: sem trimming/AOT -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <TrimMode>copy</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <IsTrimmable>false</IsTrimmable>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ===== Debug ===== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
    <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
  </PropertyGroup>

  <!-- ===== Release ===== -->
  <!-- NAO MEXER: Optimize=false + Interpreter=true sao obrigatorios no Android.
       Optimize=true quebra o layout de classes expostas via reflection em
       HleConfiguration/ContentManager/UserChannelPersistence.
       AndroidUseInterpreter=true e obrigatorio pro ARMeilleure (Horizon..ctor).
       Nao adicionar PublishTrimmed/PublishAot/AndroidLinkMode — quebram reflection. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>false</Optimize>

    <!-- Sem simbolos — release limpo -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>

    <!-- Compressao + store otimizado = APK ~90-100MB -->
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>

    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <TrimMode>copy</TrimMode>
    <IsTrimmable>false</IsTrimmable>
    <AndroidStripILAfterAOT>false</AndroidStripILAfterAOT>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidUseInterpreter>true</AndroidUseInterpreter>
    <UseInterpreter>true</UseInterpreter>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ryujinx.Common\Ryujinx.Common.csproj" />
    <ProjectReference Include="..\Ryujinx.Cpu\Ryujinx.Cpu.csproj" />
    <ProjectReference Include="..\Ryujinx.HLE\Ryujinx.HLE.csproj" />
    <ProjectReference Include="..\Ryujinx.Graphics.GAL\Ryujinx.Graphics.GAL.csproj" />
    <ProjectReference Include="..\Ryujinx.Graphics.Shader\Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="..\Ryujinx.Graphics.Vulkan\Ryujinx.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Ryujinx.Graphics.Gpu\Ryujinx.Graphics.Gpu.csproj" />
    <ProjectReference Include="..\ARMeilleure\ARMeilleure.csproj" />
    <ProjectReference Include="..\Ryujinx.Memory\Ryujinx.Memory.csproj" />
  </ItemGroup>
</Project>
